{
  "name": "bfu-smart-travel",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "北京智能旅行 · 北京 16 区景点、高校校园与城市路线规划助手",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts src/agent/*.test.ts api/chat/*.test.mjs api/*.test.mjs",
    "preview": "vite preview --port 4173",
    "dev:api": "node scripts/dev-api.mjs",
    "db:setup": "node --import tsx scripts/database.ts setup",
    "db:migrate": "node --import tsx scripts/database.ts migrate",
    "db:seed": "node --import tsx scripts/database.ts seed",
    "db:build-common": "node scripts/build-common-travel.mjs",
    "db:expand-common": "node scripts/maintain-places.mjs import database/catalogs/beijing-common-travel.json",
    "db:validate": "node scripts/maintain-places.mjs validate",
    "db:import": "node scripts/maintain-places.mjs import",
    "db:export": "node scripts/maintain-places.mjs export",
    "db:history": "node scripts/maintain-places.mjs history",
    "db:archive": "node scripts/maintain-places.mjs archive",
    "db:restore": "node scripts/maintain-places.mjs restore",
    "db:check": "node scripts/maintain-places.mjs check"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.4",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
