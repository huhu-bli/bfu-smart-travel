{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat/completions.mjs": {
      "maxDuration": 50
    },
    "api/places.mjs": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/_AMapService/:amap_path*",
      "destination": "/api/amap-proxy"
    }
  ],
  "buildCommand": "npm run typecheck && npm run build && npm run db:apply-reviewed"
}
